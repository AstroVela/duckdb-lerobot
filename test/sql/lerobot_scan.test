# name: test/sql/lerobot_scan.test
# description: LeRobot native scans reuse DuckDB JSON and Parquet readers
# group: [lerobot]

require parquet

require json

require lerobot

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           30 AS fps
) TO '__TEST_DIR__/lerobot_scan/meta/info.json' (FORMAT JSON, ARRAY false);

statement ok
COPY (
    SELECT * FROM (VALUES
        (0::BIGINT, 2::BIGINT, 0::BIGINT, 0::BIGINT),
        (1::BIGINT, 2::BIGINT, 0::BIGINT, 0::BIGINT),
        (2::BIGINT, 2::BIGINT, 0::BIGINT, 1::BIGINT)
    ) AS episodes(episode_index, length, "data/chunk_index", "data/file_index")
) TO '__TEST_DIR__/lerobot_scan/meta/episodes/chunk-000/file-000.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT * FROM (VALUES
        (0::BIGINT, 0::BIGINT, 0.0::DOUBLE),
        (0::BIGINT, 1::BIGINT, 0.033333::DOUBLE),
        (1::BIGINT, 2::BIGINT, 0.0::DOUBLE),
        (1::BIGINT, 3::BIGINT, 0.033333::DOUBLE)
    ) AS frames(episode_index, frame_index, timestamp)
) TO '__TEST_DIR__/lerobot_scan/data/chunk-000/file-000.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT * FROM (VALUES
        (2::BIGINT, 4::BIGINT, 0.0::DOUBLE),
        (2::BIGINT, 5::BIGINT, 0.033333::DOUBLE)
    ) AS frames(episode_index, frame_index, timestamp)
) TO '__TEST_DIR__/lerobot_scan/data/chunk-000/file-001.parquet' (FORMAT PARQUET);

query TTI
SELECT codebase_version, data_path, fps
FROM lerobot_info('__TEST_DIR__/lerobot_scan');
----
v3.0	data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet	30

query III
SELECT episode_index, length, "data/file_index"
FROM lerobot_episodes('__TEST_DIR__/lerobot_scan')
ORDER BY episode_index;
----
0	2	0
1	2	0
2	2	1

query II
SELECT episode_index, frame_index
FROM lerobot_episode_frames('__TEST_DIR__/lerobot_scan', [1, 2])
ORDER BY frame_index;
----
1	2
1	3
2	4
2	5

query I
SELECT count(*)
FROM lerobot_episode_frames('__TEST_DIR__/lerobot_scan', []);
----
0

statement error
SELECT *
FROM lerobot_episode_frames('__TEST_DIR__/lerobot_scan', [-1]);
----
LeRobot episode indices must be non-negative
