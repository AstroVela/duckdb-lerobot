# name: test/sql/lerobot_scan.test
# description: LeRobot native scans reuse DuckDB JSON and Parquet readers
# group: [lerobot]

require parquet

require json

require lerobot

# Partitioned COPY creates the otherwise-empty fixture directories.
statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_scan' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_scan/meta' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'frames/chunk-{chunk_index:02d}/part-{file_index:04d}.parquet' AS data_path,
           'media/{video_key}/chunk-{chunk_index:02d}/clip-{file_index:04d}.mp4' AS video_path,
           30 AS fps,
           3 AS total_episodes,
           6 AS total_frames,
           2 AS total_tasks,
           struct_pack(
               "observation.images.front" := struct_pack(dtype := 'video'),
               action := struct_pack(dtype := 'float32'),
               "observation.images.wrist" := struct_pack(dtype := 'video')
           ) AS features
) TO '{TEST_DIR}/lerobot_scan/meta/info.json' (FORMAT JSON, ARRAY false);

statement ok
COPY (
    SELECT episodes.*, 0 AS metadata_chunk FROM (VALUES
        (0::BIGINT, 2::BIGINT, 0::BIGINT, 0::BIGINT,
         0::BIGINT, 0::BIGINT, 0.0::DOUBLE, 0.066666::DOUBLE,
         0::BIGINT, 5::BIGINT, 1.0::DOUBLE, 1.066666::DOUBLE),
        (1::BIGINT, 2::BIGINT, 0::BIGINT, 0::BIGINT,
         0::BIGINT, 0::BIGINT, 0.1::DOUBLE, 0.166666::DOUBLE,
         0::BIGINT, 5::BIGINT, 1.1::DOUBLE, 1.166666::DOUBLE),
        (2::BIGINT, 2::BIGINT, 0::BIGINT, 1::BIGINT,
         0::BIGINT, 1::BIGINT, 0.2::DOUBLE, 0.266666::DOUBLE,
         NULL::BIGINT, NULL::BIGINT, NULL::DOUBLE, NULL::DOUBLE)
    ) AS episodes(
        episode_index,
        length,
        "data/chunk_index",
        "data/file_index",
        "videos/observation.images.front/chunk_index",
        "videos/observation.images.front/file_index",
        "videos/observation.images.front/from_timestamp",
        "videos/observation.images.front/to_timestamp",
        "videos/observation.images.wrist/chunk_index",
        "videos/observation.images.wrist/file_index",
        "videos/observation.images.wrist/from_timestamp",
        "videos/observation.images.wrist/to_timestamp"
    )
) TO '{TEST_DIR}/lerobot_scan/meta/episodes' (FORMAT PARQUET, PARTITION_BY (metadata_chunk));

statement ok
COPY (
    SELECT * FROM (VALUES
        (0::BIGINT, 'pick up the cube'::VARCHAR),
        (1::BIGINT, 'place the cube'::VARCHAR)
    ) AS tasks(task_index, task)
) TO '{TEST_DIR}/lerobot_scan/meta/tasks.parquet' (FORMAT PARQUET);

# Besides creating frames/chunk-00, this leaves an incompatible, unreferenced
# Parquet file beneath the same tree. Metadata-resolved frame scans must ignore
# it in both full and episode-pruned modes.
statement ok
COPY (
    SELECT 0 AS bootstrap, 'not a frame shard' AS poison
) TO '{TEST_DIR}/lerobot_scan/frames' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 0 AS bootstrap, 'not a frame shard' AS poison
) TO '{TEST_DIR}/lerobot_scan/frames/chunk-00' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT * FROM (VALUES
        (0::BIGINT, 0::BIGINT, 0.0::DOUBLE),
        (0::BIGINT, 1::BIGINT, 0.033333::DOUBLE),
        (1::BIGINT, 2::BIGINT, 0.0::DOUBLE),
        (1::BIGINT, 3::BIGINT, 0.033333::DOUBLE)
    ) AS frames(episode_index, frame_index, timestamp)
) TO '{TEST_DIR}/lerobot_scan/frames/chunk-00/part-0000.parquet' (FORMAT PARQUET);

statement ok
COPY (
    SELECT frames.*, 'schema-v2'::VARCHAR AS shard_marker FROM (VALUES
        (2::BIGINT, 4::BIGINT, 0.0::DOUBLE),
        (2::BIGINT, 5::BIGINT, 0.033333::DOUBLE)
    ) AS frames(episode_index, frame_index, timestamp)
) TO '{TEST_DIR}/lerobot_scan/frames/chunk-00/part-0001.parquet' (FORMAT PARQUET);

# The base scan resolves the complete authoritative file list through
# info.json.data_path and the episode routes. The projected/filter query must
# therefore read the custom frames/ layout while ignoring both poison files.
query TIII
SELECT component, cached, entries, bytes = 0
FROM lerobot_cache_info('{TEST_DIR}/lerobot_scan')
ORDER BY component;
----
data	false	0	true
video	false	0	true

# Repeating the diagnostic proves that its first invocation did not populate
# either route cache, especially the lazy video component.
query TIII
SELECT component, cached, entries, bytes = 0
FROM lerobot_cache_info('{TEST_DIR}/lerobot_scan')
ORDER BY component;
----
data	false	0	true
video	false	0	true

query II
SELECT episode_index, frame_index
FROM lerobot_scan('{TEST_DIR}/lerobot_scan')
WHERE episode_index >= 1
ORDER BY frame_index;
----
1	2
1	3
2	4
2	5

# The public Parquet option whitelist survives bind replacement.
# union_by_name exposes the later shard's evolved column and filename proves
# the option reaches the replacement scan.
query ITT
SELECT frame_index, coalesce(shard_marker, 'missing'), filename
FROM lerobot_scan(
    '{TEST_DIR}/lerobot_scan',
    refresh := true,
    union_by_name := true,
    filename := true
)
WHERE frame_index IN (1, 4)
ORDER BY frame_index;
----
1	missing	{TEST_DIR}/lerobot_scan/frames/chunk-00/part-0000.parquet
4	schema-v2	{TEST_DIR}/lerobot_scan/frames/chunk-00/part-0001.parquet

# ANY-typed filename values must still conform to its documented BOOLEAN or
# VARCHAR forms, including when native Parquet binding has real shards.
statement error
SELECT *
FROM lerobot_scan(
    '{TEST_DIR}/lerobot_scan',
    filename := struct_pack(enabled := true)
);
----
Unimplemented type for cast

query TTI
SELECT codebase_version, data_path, fps
FROM lerobot_info('{TEST_DIR}/lerobot_scan');
----
v3.0	frames/chunk-{chunk_index:02d}/part-{file_index:04d}.parquet	30

query III
SELECT episode_index, length, "data/file_index"
FROM lerobot_episodes('{TEST_DIR}/lerobot_scan')
ORDER BY episode_index;
----
0	2	0
1	2	0
2	2	1

query IIII
SELECT count(*), count(DISTINCT source_file), min(file_row_number), max(file_row_number)
FROM lerobot_episodes(
    '{TEST_DIR}/lerobot_scan',
    union_by_name := true,
    filename := 'source_file',
    file_row_number := true
);
----
3	1	0	2

statement error
SELECT *
FROM lerobot_episodes('{TEST_DIR}/lerobot_scan', hive_partitioning := true);
----
Invalid named parameter "hive_partitioning"

query IT
SELECT task_index, task
FROM lerobot_tasks('{TEST_DIR}/lerobot_scan')
WHERE task_index = 1;
----
1	place the cube

statement error
SELECT * FROM lerobot_tasks('{TEST_DIR}/lerobot_scan', filename := true);
----
Invalid named parameter "filename"

statement error
SELECT * FROM lerobot_info('{TEST_DIR}/lerobot_scan', format := 'newline_delimited');
----
Invalid named parameter "format"

query II
SELECT episode_index, frame_index
FROM lerobot_scan('{TEST_DIR}/lerobot_scan', episode_indices := [2, 1, 1])
ORDER BY frame_index;
----
1	2
1	3
2	4
2	5

# Parquet output options are also forwarded through the episode-pruned
# replacement relation, not only the full-scan form.
query ITTI
SELECT frame_index, shard_marker, source_file, file_row_number
FROM lerobot_scan(
    '{TEST_DIR}/lerobot_scan',
    episode_indices := [2],
    filename := 'source_file',
    file_row_number := true
)
ORDER BY frame_index;
----
4	schema-v2	{TEST_DIR}/lerobot_scan/frames/chunk-00/part-0001.parquet	0
5	schema-v2	{TEST_DIR}/lerobot_scan/frames/chunk-00/part-0001.parquet	1

query TIII
SELECT component, cached, entries, bytes > 0
FROM lerobot_cache_info('{TEST_DIR}/lerobot_scan')
ORDER BY component;
----
data	true	1	true
video	false	0	false

query ITTIIRRI
SELECT episode_index, video_key, video_path, chunk_index, file_index,
       from_timestamp, to_timestamp, fps
FROM lerobot_video_routes(
    '{TEST_DIR}/lerobot_scan',
    [2, 1, 1],
    video_keys := [
        'observation.images.wrist',
        'observation.images.front',
        'observation.images.front'
    ]
)
ORDER BY episode_index, video_key;
----
1	observation.images.front	{TEST_DIR}/lerobot_scan/media/observation.images.front/chunk-00/clip-0000.mp4	0	0	0.1	0.166666	30
1	observation.images.wrist	{TEST_DIR}/lerobot_scan/media/observation.images.wrist/chunk-00/clip-0005.mp4	0	5	1.1	1.166666	30
2	observation.images.front	{TEST_DIR}/lerobot_scan/media/observation.images.front/chunk-00/clip-0001.mp4	0	1	0.2	0.266666	30

query TIII
SELECT component, cached, entries, bytes > 0
FROM lerobot_cache_info('{TEST_DIR}/lerobot_scan')
ORDER BY component;
----
data	true	1	true
video	true	1	true

query I
SELECT count(*)
FROM lerobot_video_routes('{TEST_DIR}/lerobot_scan', [0], refresh := true);
----
2

query I
SELECT count(*)
FROM lerobot_video_routes('{TEST_DIR}/lerobot_scan', [0]);
----
2

query I
SELECT count(*)
FROM lerobot_video_routes(
    '{TEST_DIR}/lerobot_scan',
    [0, 1],
    video_keys := []
);
----
0

statement error
SELECT *
FROM lerobot_video_routes(
    '{TEST_DIR}/lerobot_scan',
    [0],
    video_keys := ['observation.images.missing']
);
----
Unknown LeRobot video key 'observation.images.missing'

query I
SELECT count(*)
FROM lerobot_info('{TEST_DIR}/lerobot_scan', refresh := true);
----
1

# Metadata bind replacement invalidates the routing caches on refresh without
# repopulating either cache as a side effect.
query TIII
SELECT component, cached, entries, bytes = 0
FROM lerobot_cache_info('{TEST_DIR}/lerobot_scan')
ORDER BY component;
----
data	false	0	true
video	false	0	true

# Rebuild both components, then change the info.json commit marker. The changed
# path length makes the fingerprint change deterministic even on coarse-mtime
# filesystems.
query I
SELECT count(*)
FROM lerobot_video_routes('{TEST_DIR}/lerobot_scan', [0]);
----
2

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'frames/chunk-{chunk_index:02d}/part-{file_index:04d}.parquet' AS data_path,
           'media-updated/{video_key}/chunk-{chunk_index:02d}/clip-{file_index:04d}.mp4' AS video_path,
           30 AS fps,
           3 AS total_episodes,
           6 AS total_frames,
           2 AS total_tasks,
           struct_pack(
               "observation.images.front" := struct_pack(dtype := 'video'),
               action := struct_pack(dtype := 'float32'),
               "observation.images.wrist" := struct_pack(dtype := 'video')
           ) AS features
) TO '{TEST_DIR}/lerobot_scan/meta/info.json'
  (FORMAT JSON, ARRAY false, OVERWRITE_OR_IGNORE);

# No explicit refresh: both stale components must be replaced from the new
# info.json fingerprint before video routes are resolved.
query T
SELECT video_path
FROM lerobot_video_routes(
    '{TEST_DIR}/lerobot_scan',
    [0],
    video_keys := ['observation.images.front']
);
----
{TEST_DIR}/lerobot_scan/media-updated/observation.images.front/chunk-00/clip-0000.mp4

query I
SELECT count(*)
FROM lerobot_scan('{TEST_DIR}/lerobot_scan', episode_indices := []);
----
0

query I
SELECT count(*)
FROM (DESCRIBE SELECT *
      FROM lerobot_scan('{TEST_DIR}/lerobot_scan', episode_indices := []));
----
3

query I
SELECT count(*)
FROM (DESCRIBE SELECT * FROM lerobot_scan(
    '{TEST_DIR}/lerobot_scan',
    episode_indices := [],
    union_by_name := true
))
WHERE column_name = 'shard_marker';
----
1

query I
SELECT count(*)
FROM lerobot_scan('{TEST_DIR}/lerobot_scan', episode_indices := [999]);
----
0

query I
SELECT count(shard_marker)
FROM lerobot_scan(
    '{TEST_DIR}/lerobot_scan',
    episode_indices := [999],
    union_by_name := true
);
----
0

statement error
SELECT *
FROM lerobot_scan('{TEST_DIR}/lerobot_scan', episode_indices := [-1]);
----
LeRobot episode indices must be non-negative

statement error
SELECT *
FROM lerobot_video_routes('{TEST_DIR}/lerobot_scan', [-1]);
----
LeRobot episode indices must be non-negative

# A frame-only v3 dataset does not need video_path or video routing columns.
statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_no_video' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_no_video/meta' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           30 AS fps,
           1 AS total_episodes,
           1 AS total_frames,
           0 AS total_tasks,
           struct_pack(action := struct_pack(dtype := 'float32')) AS features
) TO '{TEST_DIR}/lerobot_no_video/meta/info.json' (FORMAT JSON, ARRAY false);

statement ok
COPY (
    SELECT 0::BIGINT AS episode_index,
	       1::BIGINT AS length,
           0::BIGINT AS "data/chunk_index",
           0::BIGINT AS "data/file_index",
           0 AS metadata_chunk
) TO '{TEST_DIR}/lerobot_no_video/meta/episodes' (FORMAT PARQUET, PARTITION_BY (metadata_chunk));

query IIT
SELECT fps, total_episodes, features.action.dtype
FROM lerobot_info('{TEST_DIR}/lerobot_no_video');
----
30	1	float32

query I
SELECT count(*)
FROM lerobot_video_routes('{TEST_DIR}/lerobot_no_video', [0]);
----
0

# Current depth videos must carry the complete canonical quantizer metadata.
# The reader does not infer defaults or inspect legacy depth markers.
statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_incomplete_depth' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_incomplete_depth/meta' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           30 AS fps,
           0 AS total_episodes,
           0 AS total_frames,
           0 AS total_tasks,
           struct_pack(
               "observation.images.depth" := struct_pack(
                   dtype := 'video',
                   shape := [64, 64, 1],
                   info := struct_pack(is_depth_map := true)
               )
           ) AS features
) TO '{TEST_DIR}/lerobot_incomplete_depth/meta/info.json' (FORMAT JSON, ARRAY false);

statement error
SELECT *
FROM lerobot_scan('{TEST_DIR}/lerobot_incomplete_depth');
----
requires video.depth_min, video.depth_max, video.shift, video.use_log, video.pix_fmt, and a channel dimension

# A current one-channel/gray12le stream must opt in through the canonical marker;
# it is never inferred and must not silently enter the RGB24 path.
statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           30 AS fps,
           0 AS total_episodes,
           0 AS total_frames,
           0 AS total_tasks,
           struct_pack(
               "observation.images.depth" := struct_pack(
                   dtype := 'video',
                   shape := [64, 64, 1],
                   info := struct_pack(
                       "video.pix_fmt" := 'gray12le',
                       "video.depth_min" := 0.01,
                       "video.depth_max" := 10.0,
                       "video.shift" := 3.5,
                       "video.use_log" := true,
                       is_depth_map := false
                   )
               )
           ) AS features
) TO '{TEST_DIR}/lerobot_incomplete_depth/meta/info.json'
  (FORMAT JSON, ARRAY false, OVERWRITE_OR_IGNORE);

statement error
SELECT *
FROM lerobot_scan('{TEST_DIR}/lerobot_incomplete_depth', refresh := true);
----
uses depth-only metadata but info.is_depth_map is not true

# Legacy marker presence is rejected even when no shape or codec field is
# available to infer that the feature is depth.
statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           30 AS fps,
           0 AS total_episodes,
           0 AS total_frames,
           0 AS total_tasks,
           struct_pack(
               "observation.images.depth" := struct_pack(
                   dtype := 'video',
                   info := struct_pack("video.is_depth_map" := true)
               )
           ) AS features
) TO '{TEST_DIR}/lerobot_incomplete_depth/meta/info.json'
  (FORMAT JSON, ARRAY false, OVERWRITE_OR_IGNORE);

statement error
SELECT *
FROM lerobot_scan('{TEST_DIR}/lerobot_incomplete_depth', refresh := true);
----
uses a legacy depth marker; use info.is_depth_map instead

# Duplicate video keys are rejected globally rather than only when their
# occurrences happen to be adjacent in the source object.
statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_duplicate_video_key' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 0 AS bootstrap, 1 AS payload
) TO '{TEST_DIR}/lerobot_duplicate_video_key/meta' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           30 AS fps,
           0 AS total_episodes,
           0 AS total_frames,
           0 AS total_tasks,
           json('{"observation.images.front":{"dtype":"video"},"observation.images.wrist":{"dtype":"video"},"observation.images.front":{"dtype":"video"}}') AS features
) TO '{TEST_DIR}/lerobot_duplicate_video_key/meta/info.json' (FORMAT JSON, ARRAY false);

statement error
SELECT *
FROM lerobot_scan('{TEST_DIR}/lerobot_duplicate_video_key');
----
Duplicate LeRobot video feature key 'observation.images.front' in info.json
