----
2

# Native LeRobot publishes info.json but no Parquet metadata or data files when
# a newly created dataset has no episodes. FORMAT lerobot keeps that layout,
# frame and episode readers derive empty schemas from the committed info.json,
# while the task reader publishes its fixed v3 schema.
statement ok
COPY (
    SELECT 0::BIGINT AS episode_index,
           ''::VARCHAR AS task,
           array_value(0::FLOAT, 0::FLOAT) AS "observation.state",
           0::BIGINT AS action,
           NULL::BLOB AS "observation.images.image",
           NULL::BLOB AS "observation.images.video",
           NULL::BLOB AS "observation.images.depth"
    WHERE false
) TO '{TEST_DIR}/lerobot_copy_empty' (
    FORMAT lerobot,
    FPS 30,
    FEATURES '{"observation.state":{"dtype":"float32","shape":[2],"names":["x","y"]},"action":{"dtype":"int64","shape":[1],"names":null},"observation.images.image":{"dtype":"image","shape":[2,3,3],"names":["height","width","channels"]},"observation.images.video":{"dtype":"video","shape":[2,3,3],"names":["height","width","channels"]},"observation.images.depth":{"dtype":"video","shape":[2,3,1],"names":["height","width","channels"],"info":{"is_depth_map":true}}}'
);

