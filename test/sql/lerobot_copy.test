statement ok
COPY (
    SELECT 0::BIGINT AS episode_index, 'block'::VARCHAR AS task,
           CASE i % 3
               WHEN 0 THEN 100000000::FLOAT
               WHEN 1 THEN -100000000::FLOAT
               ELSE 1::FLOAT
           END AS action
    FROM range(129) rows(i)
    ORDER BY i
) TO '{TEST_DIR}/lerobot_copy_pairwise_block' (
    FORMAT lerobot,
    FPS 30,
    FEATURES '{"action":{"dtype":"float32","shape":[1],"names":null}}'
);

# Sequential float32 summation produces one here; NumPy's recursive 128-value
# block split produces zero and is the contract used by RunningQuantileStats.
query II
SELECT "stats/action/mean"[1] = 0,
       "stats/action/std"[1] = 81649656
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_pairwise_block');
----
true	true

# A long, wide episode must stay inside DuckDB's buffer-manager budget. The
# writer scans the spillable episode collection instead of retaining one
# extension-owned double vector per feature dimension. Sixty-five dimensions
# also cross the fixed 64-dimension statistics scratch batch.
statement ok
SET memory_limit = '64MB';

statement ok
COPY (
    SELECT 0::BIGINT AS episode_index, 'bounded'::VARCHAR AS task,
           CAST(list_resize([(i % 100)::FLOAT], 65, (i % 100)::FLOAT) AS FLOAT[65])
               AS "observation.state"
    FROM range(100000) rows(i)
) TO '{TEST_DIR}/lerobot_copy_bounded_stats' (
    FORMAT lerobot,
    FPS 30,
    FEATURES '{"observation.state":{"dtype":"float32","shape":[65],"names":null}}'
);

query III
SELECT length = 100000,
       "stats/observation.state/min"[1] = 0,
       "stats/observation.state/max"[65] = 99
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_bounded_stats');
----
true	true	true

statement ok
RESET memory_limit;

statement ok
COPY (
    SELECT 0::BIGINT AS episode_index, 'singleton'::VARCHAR AS task,
           1e30::FLOAT AS action
) TO '{TEST_DIR}/lerobot_copy_singleton_stats' (
    FORMAT lerobot,
    FPS 30,
    FEATURES '{"action":{"dtype":"float32","shape":[1],"names":null}}'
);

query II
