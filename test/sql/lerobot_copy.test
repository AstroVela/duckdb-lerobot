       typeof("stats/unsigned_u8/max"), typeof("stats/unsigned_u16/max"),
       typeof("stats/unsigned_u32/max"), typeof("stats/unsigned_u64/max")
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_integer_stats')
LIMIT 1;
----
BIGINT[]	BIGINT[]	BIGINT[]	BIGINT[]	BIGINT[]	BIGINT[]	BIGINT[]	UBIGINT[]

