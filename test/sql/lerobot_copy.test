feature names must not contain '/'

# DuckDB identifiers are case-insensitive. Generated feature names must use the
# same rule so COPY cannot publish an ambiguous schema that its reader rejects.
statement error
COPY (
    SELECT 0::BIGINT AS episode_index, 'pick'::VARCHAR AS task,
           0::FLOAT AS "Timestamp"
) TO '{TEST_DIR}/lerobot_copy_reserved_feature_name' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"Timestamp":{"dtype":"float32","shape":[1]}}'
);
----
feature 'Timestamp' is generated by FORMAT lerobot
