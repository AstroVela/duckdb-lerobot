# name: test/sql/lerobot_copy.test
# description: Native COPY writes a strict LeRobot v3 dataset and publishes metadata last
# group: [lerobot]

require parquet

require json

require lerobot

statement error
COPY (
    SELECT 0::BIGINT AS episode_index, 'invalid workers'::VARCHAR AS task,
           1.0::FLOAT AS action
) TO '{TEST_DIR}/lerobot_copy_invalid_video_workers' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"action":{"dtype":"float32","shape":[1],"names":null}}',
    VIDEO_WORKERS 0
);
----
LeRobot VIDEO_WORKERS must be between 1 and the DuckDB thread limit

# A tiny data-file limit forces the second episode into the next chunk. One
# metadata row per flush exercises the same rotation path for meta/episodes.
statement ok
COPY (
    SELECT episode_index, task,
           array_value(value::FLOAT, (value + 10)::FLOAT) AS "observation.state",
           (value / 10.0)::FLOAT AS action
    FROM (VALUES
        (0::BIGINT, 'pick'::VARCHAR, 0),
        (0::BIGINT, 'pick'::VARCHAR, 1),
        (1::BIGINT, 'place'::VARCHAR, 10),
        (1::BIGINT, 'place'::VARCHAR, 11)
    ) rows(episode_index, task, value)
    ORDER BY episode_index, value
) TO '{TEST_DIR}/lerobot_copy' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.state":{"dtype":"float32","shape":[2],"names":["x","y"]},"action":{"dtype":"float32","shape":[1],"names":null}}',
    ROBOT_TYPE 'testbot',
    CHUNKS_SIZE 1,
    DATA_FILES_SIZE_IN_MB 0.000001,
    METADATA_BUFFER_SIZE 1
);

query TTI
SELECT codebase_version, data_path, fps
FROM lerobot_info('{TEST_DIR}/lerobot_copy');
----
v3.0	data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet	10

query IIIIIRRI
SELECT episode_index, frame_index, "index", task_index,
	       CAST("observation.state"[1] AS INTEGER), round(action, 1), round(timestamp, 1),
	       length(CAST("observation.state" AS VARCHAR)) > 0
FROM lerobot_scan('{TEST_DIR}/lerobot_copy')
ORDER BY "index";
----
0	0	0	0	0	0.0	0.0	true
0	1	1	0	1	0.1	0.1	true
1	0	2	1	10	1.0	0.0	true
1	1	3	1	11	1.1	0.1	true

query IT
SELECT task_index, task
FROM lerobot_tasks('{TEST_DIR}/lerobot_copy')
ORDER BY task_index;
----
0	pick
1	place

query IIIIIII
SELECT episode_index, length, "data/chunk_index", "data/file_index",
       dataset_from_index, dataset_to_index, "meta/episodes/chunk_index"
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy')
ORDER BY episode_index;
----
0	2	0	0	0	2	0
1	2	1	0	2	4	1

# The generated timestamp is stored as float32 but, like LeRobot, its stats
# are calculated from frame_index / fps before the Arrow cast.
query RRRR
SELECT round("stats/action/mean"[1], 6),
       round("stats/action/q90"[1], 6),
       round("stats/timestamp/mean"[1], 6),
       round("stats/timestamp/q90"[1], 6)
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy')
WHERE episode_index = 0;
----
0.05	0.099996	0.05	0.099996

# Keep NumPy's float32 intermediate rounding exact. Variegata binds the long
# decimal literal as DECIMAL(18,17), so cast it explicitly before comparing the
# binary DOUBLE emitted by the episode Parquet file.
query III
SELECT "stats/action/std"[1] = 0.05000000074505806,
       "stats/action/q90"[1] = CAST('0.09999600052833557' AS DOUBLE),
       "stats/timestamp/q90"[1] = 0.099996000099992
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy')
WHERE episode_index = 0;
----
true	true	true

query I
SELECT CAST(json_extract(content, '$.action.std[0]') AS DOUBLE) = 0.5024938447111051
FROM read_text('{TEST_DIR}/lerobot_copy/meta/stats.json');
----
true

# NumPy reduces float32 batches sequentially below eight values and switches to
# an eight-lane, 128-value pairwise reduction for larger inputs. Cover the
# sub-eight case and its subsequent incremental episode aggregation exactly.
statement ok
COPY (
    SELECT *
    FROM (VALUES
        (0::BIGINT, 'task-0'::VARCHAR, 0.1::FLOAT),
        (0::BIGINT, 'task-0'::VARCHAR, -2.3::FLOAT),
        (0::BIGINT, 'task-0'::VARCHAR, 4.5::FLOAT),
        (1::BIGINT, 'task-1'::VARCHAR, 100.25::FLOAT),
        (1::BIGINT, 'task-1'::VARCHAR, -0.75::FLOAT),
        (2::BIGINT, 'task-2'::VARCHAR, 0.001::FLOAT),
        (2::BIGINT, 'task-2'::VARCHAR, 0.002::FLOAT),
        (2::BIGINT, 'task-2'::VARCHAR, 0.003::FLOAT),
        (2::BIGINT, 'task-2'::VARCHAR, 0.004::FLOAT)
    ) rows(episode_index, task, action)
) TO '{TEST_DIR}/lerobot_copy_pairwise_stats' (
    FORMAT lerobot,
    FPS 30,
    FEATURES '{"action":{"dtype":"float32","shape":[1],"names":null}}'
);

query II
SELECT "stats/action/mean"[1] = 0.0024999999441206455,
       "stats/action/std"[1] = 0.0011180343572050333
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_pairwise_stats')
WHERE episode_index = 2;
----
true	true

query II
SELECT CAST(json_extract(content, '$.action.mean[0]') AS DOUBLE) = 11.312222216899196,
       CAST(json_extract(content, '$.action.std[0]') AS DOUBLE) = 31.489817909433381
FROM read_text('{TEST_DIR}/lerobot_copy_pairwise_stats/meta/stats.json');
----
true	true

# Integer extrema use native-compatible integer leaves and never pass through
# DOUBLE. Floating moments and quantiles intentionally keep the native LeRobot
# floating-point contract.
statement ok
COPY (
    SELECT rows.*,
           CAST(list_resize([signed_nested[1][2]], 65, signed_nested[1][2]) AS BIGINT[65])
               AS signed_wide
    FROM (VALUES
        (0::BIGINT, 'integer'::VARCHAR,
         CAST('-128' AS TINYINT), CAST('-32768' AS SMALLINT), CAST('-2147483648' AS INTEGER),
         CAST('-9223372036854775808' AS BIGINT), 0::UTINYINT, 0::USMALLINT, 0::UINTEGER,
         CAST('9007199254740993' AS UBIGINT),
         array_value(
             array_value(-100::BIGINT, 9007199254740991::BIGINT),
             array_value(9007199254740993::BIGINT, 100::BIGINT))),
        (0::BIGINT, 'integer'::VARCHAR,
         127::TINYINT, 32767::SMALLINT, 2147483647::INTEGER, 9223372036854775807::BIGINT,
         255::UTINYINT, 65535::USMALLINT, 4294967295::UINTEGER,
         CAST('18446744073709551615' AS UBIGINT),
         array_value(
             array_value(-50::BIGINT, 9007199254740993::BIGINT),
             array_value(9007199254740991::BIGINT, 200::BIGINT))),
        (1::BIGINT, 'integer'::VARCHAR,
         0::TINYINT, 0::SMALLINT, 0::INTEGER, 0::BIGINT,
         1::UTINYINT, 1::USMALLINT, 1::UINTEGER, CAST('9007199254740997' AS UBIGINT),
         array_value(
             array_value(CAST('-9223372036854775808' AS BIGINT), 5::BIGINT),
             array_value(6::BIGINT, 9223372036854775807::BIGINT))),
        (1::BIGINT, 'integer'::VARCHAR,
         1::TINYINT, 1::SMALLINT, 1::INTEGER, 1::BIGINT,
         2::UTINYINT, 2::USMALLINT, 2::UINTEGER, CAST('9007199254740999' AS UBIGINT),
         array_value(
             array_value(-1::BIGINT, 7::BIGINT),
             array_value(8::BIGINT, 0::BIGINT))),
        (2::BIGINT, 'integer'::VARCHAR,
         2::TINYINT, 2::SMALLINT, 2::INTEGER, 9007199254740993::BIGINT,
         3::UTINYINT, 3::USMALLINT, 3::UINTEGER, CAST('9007199254740993' AS UBIGINT),
         array_value(
             array_value(2::BIGINT, 9007199254740993::BIGINT),
             array_value(2::BIGINT, 2::BIGINT)))
    ) rows(episode_index, task, signed_i8, signed_i16, signed_i32, signed_i64,
           unsigned_u8, unsigned_u16, unsigned_u32, unsigned_u64, signed_nested)
    ORDER BY episode_index
) TO '{TEST_DIR}/lerobot_copy_integer_stats' (
    FORMAT lerobot,
    FPS 30,
    FEATURES '{"signed_i8":{"dtype":"int8","shape":[1]},"signed_i16":{"dtype":"int16","shape":[1]},"signed_i32":{"dtype":"int32","shape":[1]},"signed_i64":{"dtype":"int64","shape":[1]},"unsigned_u8":{"dtype":"uint8","shape":[1]},"unsigned_u16":{"dtype":"uint16","shape":[1]},"unsigned_u32":{"dtype":"uint32","shape":[1]},"unsigned_u64":{"dtype":"uint64","shape":[1]},"signed_nested":{"dtype":"int64","shape":[2,2]},"signed_wide":{"dtype":"int64","shape":[65]}}'
);

query TTTTTTTT
SELECT typeof("stats/signed_i8/min"), typeof("stats/signed_i16/min"),
