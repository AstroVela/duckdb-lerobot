# Create-only publication prevents an accidental overwrite.
statement error
COPY (
    SELECT 0::BIGINT AS episode_index, 'pick'::VARCHAR AS task,
           array_value(0::FLOAT, 1::FLOAT) AS "observation.state",
           0::FLOAT AS action
) TO '{TEST_DIR}/lerobot_copy' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.state":{"dtype":"float32","shape":[2]},"action":{"dtype":"float32","shape":[1]}}'
);
----
dataset root already exists

# An execution-time episode-order failure must remove both the destination and
# its UUID staging directory.
statement error
COPY (
    SELECT episode_index, 'bad'::VARCHAR AS task, 0::FLOAT AS action
    FROM (VALUES (0::BIGINT), (2::BIGINT)) rows(episode_index)
	ORDER BY episode_index
) TO '{TEST_DIR}/lerobot_copy_failed' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"action":{"dtype":"float32","shape":[1]}}'
);
----
episodes must be contiguous and ordered from zero

query I
SELECT count(*)
FROM glob('{TEST_DIR}/lerobot_copy_failed*');
----
0

