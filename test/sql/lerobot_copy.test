       count_if(column_name = 'observation.images.image' AND contains(column_type, 'bytes VARCHAR')) = 0
FROM (DESCRIBE SELECT * FROM lerobot_scan(
    '{TEST_DIR}/lerobot_copy_empty', binary_as_string := false
));
----
true	true

