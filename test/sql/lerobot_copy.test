# A singleton takes LeRobot's basic-statistics branch: extrema remain exact,
# while the floating results expose the expected binary64 rounding above 2^53.
query IIIIII
SELECT "stats/signed_i64/min"[1] = 9007199254740993::BIGINT,
       "stats/signed_i64/max"[1] = 9007199254740993::BIGINT,
       "stats/signed_i64/mean"[1] = 9007199254740992::DOUBLE,
       "stats/signed_i64/std"[1] = 0::DOUBLE,
       "stats/signed_i64/q50"[1] = "stats/signed_i64/mean"[1],
       typeof("stats/signed_i64/q50") = 'DOUBLE[]'
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_integer_stats')
WHERE episode_index = 2;
----
true	true	true	true	true	true

query TTT
