# A frame misplaced in another selected shard is still a duplicate.
statement ok
COPY (SELECT 0::BIGINT AS episode_index, i AS frame_index, i / 2.0 AS timestamp FROM range(6) r(i))
TO '{TEST_DIR}/lerobot_timestamp_lookup/data-000.parquet' (FORMAT PARQUET);

