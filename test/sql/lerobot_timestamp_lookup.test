# Index construction must not introduce errors from unrequested string casts.
statement ok
COPY (SELECT 0::BIGINT AS episode_index, i AS frame_index,
             CASE WHEN i = 5 THEN 'broken' ELSE '0.5' END AS timestamp FROM range(6) r(i))
TO '{TEST_DIR}/lerobot_timestamp_lookup/data-000.parquet' (FORMAT PARQUET);

