# name: test/sql/lerobot_video_frames.test
# description: Shard-aware native FFmpeg decode aligns LeRobot frame timestamps
# group: [lerobot]

require-env LEROBOT_FFMPEG_TESTS

require parquet

require json

require lerobot

# Create the dataset and metadata directories without relying on shell helpers.
statement ok
COPY (SELECT 0 AS bootstrap, 1 AS payload)
TO '{TEST_DIR}/lerobot_video_frames' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (SELECT 0 AS bootstrap, 1 AS payload)
TO '{TEST_DIR}/lerobot_video_frames/meta' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data.parquet' AS data_path,
           'video-{file_index:03d}.mp4' AS video_path,
           2 AS fps,
           struct_pack(
               "observation.images.front" := struct_pack(dtype := 'video'),
               "observation.images.wrist" := struct_pack(dtype := 'video')
           ) AS features
) TO '{TEST_DIR}/lerobot_video_frames/meta/info.json' (FORMAT JSON, ARRAY false);

statement ok
COPY (
    SELECT episodes.*, 0 AS metadata_chunk FROM (VALUES
        (0::BIGINT, 0::BIGINT, 0::BIGINT,
         0::BIGINT, 0::BIGINT, 0.0::DOUBLE, 0.5::DOUBLE,
         0::BIGINT, 1::BIGINT, 0.0::DOUBLE, 0.5::DOUBLE),
        (1::BIGINT, 0::BIGINT, 0::BIGINT,
         0::BIGINT, 0::BIGINT, 1.0::DOUBLE, 1.5::DOUBLE,
         0::BIGINT, 1::BIGINT, 1.0::DOUBLE, 1.5::DOUBLE)
    ) AS episodes(
        episode_index,
        "data/chunk_index",
        "data/file_index",
        "videos/observation.images.front/chunk_index",
        "videos/observation.images.front/file_index",
        "videos/observation.images.front/from_timestamp",
        "videos/observation.images.front/to_timestamp",
        "videos/observation.images.wrist/chunk_index",
        "videos/observation.images.wrist/file_index",
        "videos/observation.images.wrist/from_timestamp",
        "videos/observation.images.wrist/to_timestamp"
    )
) TO '{TEST_DIR}/lerobot_video_frames/meta/episodes'
  (FORMAT PARQUET, PARTITION_BY ('metadata_chunk'));

statement ok
COPY (
    SELECT * FROM (VALUES
        (0::BIGINT, 0::BIGINT, 0.0::DOUBLE),
        (0::BIGINT, 1::BIGINT, 0.5::DOUBLE),
        (0::BIGINT, 4::BIGINT, 0.25::DOUBLE),
        (1::BIGINT, 2::BIGINT, 0.0::DOUBLE),
        (1::BIGINT, 3::BIGINT, 0.5::DOUBLE)
    ) AS frames(episode_index, frame_index, timestamp)
) TO '{TEST_DIR}/lerobot_video_frames/data.parquet' (FORMAT PARQUET);

# Four 16x16 H.264 frames at 2 FPS. Keeping the tiny fixture inline makes the
# SQLLogic test independent of its process working directory.
statement ok
COPY (
    SELECT unhex(
        ''
    ) AS content
) TO '{TEST_DIR}/lerobot_video_frames/video-000.mp4' (FORMAT BLOB);

statement ok
COPY (
    SELECT content
    FROM read_blob('{TEST_DIR}/lerobot_video_frames/video-000.mp4')
) TO '{TEST_DIR}/lerobot_video_frames/video-001.mp4' (FORMAT BLOB);

query IIRRIIIII
SELECT episode_index, frame_index, video_timestamp, decoded_timestamp,
       width, height, channels, octet_length(image), length(md5(image))
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [1, 0, 1],
    video_keys := ['observation.images.front'],
    frame_indices := [3, 2, 1, 0, 0],
    cluster_gap := 0.1
)
ORDER BY frame_index;
----
0	0	0.0	0.0	16	16	3	768	32
0	1	0.5	0.5	16	16	3	768	32
1	2	1.0	1.0	16	16	3	768	32
1	3	1.5	1.5	16	16	3	768	32

# One-target buffers alternate between two camera shards. A one-entry decoder
# cache forces LRU close/reopen while preserving every aligned output row.
query III
SELECT count(*), count(DISTINCT video_path), count(DISTINCT md5(image))
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0, 1],
    frame_indices := [0, 1, 2, 3],
    batch_size := 1,
    target_buffer_size := 1,
    max_open_shards := 1
);
----
8	2	4

# A decoder session survives target-buffer boundaries for the same shard. These
# four one-target buffers are monotonic, so they can continue without a seek.
query IR
SELECT frame_index, decoded_timestamp
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0, 1],
    video_keys := ['observation.images.front'],
    frame_indices := [0, 1, 2, 3],
    batch_size := 1,
    target_buffer_size := 1,
    max_open_shards := 1
)
ORDER BY frame_index;
----
0	0.0
1	0.5
2	1.0
3	1.5

query IIII
SELECT min(width), max(width), min(octet_length(image)), max(octet_length(image))
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    video_keys := ['observation.images.front'],
    frame_indices := [0, 1],
    width := 8,
    height := 6
);
----
8	8	144	144

# These hashes are the PyAV rgb24 output resized with Pillow NEAREST, matching
# the current Daft LeRobot decoder's pixel contract.
query IT
SELECT frame_index, md5(image)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    video_keys := ['observation.images.front'],
    frame_indices := [0, 1],
    width := 8,
    height := 6
)
ORDER BY frame_index;
----
0	499a430c62bdd056e51ccd6dab4ea9c3
1	6fc8ed6bd6221ef2e8f6303f2d34c5bf

# A target exactly between two frames resolves to the earlier frame, matching
# LeRobot/PyTorch argmin tie behaviour.
query IR
SELECT count(DISTINCT md5(image)), max(decoded_timestamp)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    video_keys := ['observation.images.front'],
    frame_indices := [0, 4]
);
----
1	0.0

statement error
SELECT *
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    video_keys := ['observation.images.front'],
    frame_indices := [4],
    tolerance := 0.01
);
----
No frame in LeRobot video

query I
SELECT count(*)
FROM lerobot_video_frames('{TEST_DIR}/lerobot_video_frames', []);
----
0

statement error
SELECT *
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    width := 8
);
----
width and height must either both be zero or both be positive

statement error
SELECT *
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    batch_size := 0
);
----
batch_size must be between 1

statement error
SELECT *
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    target_buffer_size := 0
);
----
target_buffer_size must be between 1

statement error
SELECT *
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_frames',
    [0],
    max_open_shards := 0
);
----
max_open_shards must be between 1
