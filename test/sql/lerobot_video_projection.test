# name: test/sql/lerobot_video_projection.test
# description: Metadata-only video projections do not require FFmpeg or open MP4 files
# group: [lerobot]

require parquet

require json

require lerobot

statement ok
COPY (SELECT 0 AS bootstrap, 1 AS payload)
TO '{TEST_DIR}/lerobot_video_projection' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (SELECT 0 AS bootstrap, 1 AS payload)
TO '{TEST_DIR}/lerobot_video_projection/meta' (FORMAT PARQUET, PARTITION_BY (bootstrap));

statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           'data.parquet' AS data_path,
           'missing-{file_index:03d}.mp4' AS video_path,
           2 AS fps,
           struct_pack(
               "observation.images.front" := struct_pack(dtype := 'video')
           ) AS features
) TO '{TEST_DIR}/lerobot_video_projection/meta/info.json' (FORMAT JSON, ARRAY false);

statement ok
COPY (
    SELECT episodes.*, 0 AS metadata_chunk FROM (VALUES
        (0::BIGINT, 2::BIGINT, 0::BIGINT, 0::BIGINT,
         0::BIGINT, 0::BIGINT, 0.0::DOUBLE, 0.5::DOUBLE),
        (1::BIGINT, 1::BIGINT, 0::BIGINT, 0::BIGINT,
         0::BIGINT, 0::BIGINT, 1.0::DOUBLE, 1.0::DOUBLE)
    ) AS episodes(
        episode_index,
        length,
        "data/chunk_index",
        "data/file_index",
        "videos/observation.images.front/chunk_index",
        "videos/observation.images.front/file_index",
        "videos/observation.images.front/from_timestamp",
        "videos/observation.images.front/to_timestamp"
    )
) TO '{TEST_DIR}/lerobot_video_projection/meta/episodes'
  (FORMAT PARQUET, PARTITION_BY ('metadata_chunk'));

statement ok
COPY (
    SELECT * FROM (VALUES
        (0::BIGINT, 0::BIGINT, 0.0::DOUBLE),
        (0::BIGINT, 1::BIGINT, 0.5::DOUBLE),
        (1::BIGINT, 0::BIGINT, 0.0002::DOUBLE)
    ) AS frames(episode_index, frame_index, timestamp)
) TO '{TEST_DIR}/lerobot_video_projection/data.parquet' (FORMAT PARQUET);

# count(*) projects no decode-dependent columns and must not open the missing MP4.
query I
SELECT count(*)
FROM lerobot_video_frames('{TEST_DIR}/lerobot_video_projection', [0]);
----
2

query IITII
SELECT episode_index, frame_index, video_path, width, height
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_projection',
    [0],
    width := 8,
    height := 6
)
ORDER BY frame_index;
----
0	0	{TEST_DIR}/lerobot_video_projection/missing-000.mp4	8	6
0	1	{TEST_DIR}/lerobot_video_projection/missing-000.mp4	8	6

query IIIII
SELECT request_id, delta_ordinal, CAST(is_padding AS INTEGER),
       target_frame_index, count(*) OVER ()
FROM lerobot_video_windows(
    '{TEST_DIR}/lerobot_video_projection',
    [struct_pack(request_id := 7::BIGINT, episode_index := 0::BIGINT, frame_index := 0::BIGINT)],
    delta_timestamps := [-0.5, 0.0, 0.5]
)
ORDER BY delta_ordinal;
----
7	0	1	0	3
7	1	0	0	3
7	2	0	1	3

# Duplicate request identifiers and target frames remain distinct logical rows.
query III
SELECT request_id, request_ordinal, target_frame_index
FROM lerobot_video_windows(
    '{TEST_DIR}/lerobot_video_projection',
    [
        struct_pack(request_id := 9::BIGINT, episode_index := 0::BIGINT, frame_index := 1::BIGINT),
        struct_pack(request_id := 9::BIGINT, episode_index := 0::BIGINT, frame_index := 0::BIGINT)
    ]
)
ORDER BY request_ordinal;
----
9	0	1
9	1	0

# The relation entry consumes typed vectors, keeps duplicate logical requests,
# selects one camera/delta per row, and exposes a distinct target_ordinal.
query IIIIIIRT
SELECT request_id, target_ordinal, delta_index, CAST(is_padding AS INTEGER),
       target_frame_index, frame_index, timestamp, video_key
FROM lerobot_video_targets(
    '{TEST_DIR}/lerobot_video_projection',
    (SELECT * FROM (VALUES
        (9, 0, 0, 'observation.images.front', 0),
        (9, 0, 0, 'observation.images.front', 0),
        (10, 0, 0, 'observation.images.front', 1),
        (11, 0, 0, 'observation.images.front', 2)
    ) targets(request_id, episode_index, frame_index, video_key, delta_index)),
    delta_timestamps := [-0.5, 0.0, 0.5],
    decode_threads := 1,
    max_pending_targets := 2
)
ORDER BY target_ordinal;
----
9	0	0	1	0	0	0.0	observation.images.front
9	1	0	1	0	0	0.0	observation.images.front
10	2	1	0	0	0	0.0	observation.images.front
11	3	2	0	1	0	0.5	observation.images.front

# Filters in the child relation run before routing/decode. Metadata-only output
# projection must not open the deliberately missing MP4.
query II
SELECT request_id, target_frame_index
FROM lerobot_video_targets(
    '{TEST_DIR}/lerobot_video_projection',
    (SELECT request_id, episode_index, frame_index, video_key, delta_index
     FROM (VALUES
        (20, 0, 0, 'observation.images.front', 0),
        (21, 0, 1, 'observation.images.front', 0)
     ) targets(request_id, episode_index, frame_index, video_key, delta_index)
     WHERE request_id = 21)
);
----
21	1

# Output filters pushed into the legacy source are evaluated by its typed
# filter executor rather than being silently dropped.
query I
SELECT frame_index
FROM lerobot_video_frames('{TEST_DIR}/lerobot_video_projection', [0])
WHERE frame_index = 1;
----
1

# DuckDB retains a pushed filter column even when it is not part of the final
# projection. The extension evaluates it before the outer projection removes it.
query I
SELECT episode_index
FROM lerobot_video_frames('{TEST_DIR}/lerobot_video_projection', [0])
WHERE frame_index = 1;
----
0

statement error
SELECT *
FROM lerobot_video_targets(
    '{TEST_DIR}/lerobot_video_projection',
    (SELECT 1 AS request_id, 0 AS episode_index, 0 AS frame_index,
            'observation.images.front' AS video_key, 3 AS delta_index),
    delta_timestamps := [-0.5, 0.0, 0.5]
);
----
delta_index 3 is outside

# Current LeRobot's strict default tolerance is 1e-4 seconds. This frame's
# absolute timestamp is 0.0002 seconds past the inclusive route endpoint.
statement error
SELECT target_frame_index
FROM lerobot_video_targets(
    '{TEST_DIR}/lerobot_video_projection',
    (SELECT 30 AS request_id, 1 AS episode_index, 0 AS frame_index,
            'observation.images.front' AS video_key, 0 AS delta_index)
);
----
falls outside video route
