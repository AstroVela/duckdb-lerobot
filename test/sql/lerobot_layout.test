# name: test/sql/lerobot_layout.test
# description: LeRobot layout paths are normalized without accessing storage
# group: [lerobot]

require parquet

require json

require lerobot

query T
SELECT DISTINCT function_name
FROM duckdb_functions()
WHERE function_name IN ('lerobot_episode_frames', 'lerobot_episodes', 'lerobot_frames', 'lerobot_info')
ORDER BY function_name;
----
lerobot_episode_frames
lerobot_episodes
lerobot_frames
lerobot_info

query TTTTT
SELECT * FROM lerobot_layout('hf://datasets/lerobot/droid_1.0.1/');
----
hf://datasets/lerobot/droid_1.0.1	hf://datasets/lerobot/droid_1.0.1/meta/info.json	hf://datasets/lerobot/droid_1.0.1/meta/episodes	hf://datasets/lerobot/droid_1.0.1/data	hf://datasets/lerobot/droid_1.0.1/videos

query T
SELECT root FROM lerobot_layout('lerobot/droid_1.0.1');
----
hf://datasets/lerobot/droid_1.0.1

query TTT
SELECT *
FROM lerobot_v3_shard_paths('hf://datasets/lerobot/droid_1.0.1', 'observation.images.wrist', 2, 17);
----
hf://datasets/lerobot/droid_1.0.1/meta/episodes/chunk-002/file-017.parquet	hf://datasets/lerobot/droid_1.0.1/data/chunk-002/file-017.parquet	hf://datasets/lerobot/droid_1.0.1/videos/observation.images.wrist/chunk-002/file-017.mp4

statement error
SELECT * FROM lerobot_v3_shard_paths('/dataset', 'cam', -1, 0);
----
LeRobot shard indices must be non-negative
