# A failure inside one background query is published to consumers and cancels
# the other producer instead of being mistaken for source exhaustion.
statement ok
COPY (
    SELECT 1::BIGINT AS episode_index,
           0::BIGINT AS frame_index,
           'not-a-number'::VARCHAR AS timestamp
) TO '{TEST_DIR}/lerobot_video_pipeline/data-001.parquet'
  (FORMAT PARQUET, OVERWRITE_OR_IGNORE TRUE);

statement error
SELECT count(*)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_pipeline',
    [0, 1],
    video_keys := ['observation.images.front'],
    producer_threads := 2,
    target_buffer_size := 1,
    max_pending_targets := 1
);
----
Failed to read LeRobot frame timestamps

# With partial task scheduling, a producer yields after 64 source rows. An
# async consumer waiter must help run the yielded producer when there is only
# one DuckDB worker instead of occupying that worker indefinitely.
statement ok
COPY (
    SELECT 0::BIGINT AS episode_index,
           (range % 2)::BIGINT AS frame_index,
           ((range % 2) * 0.5)::DOUBLE AS timestamp
    FROM range(128)
) TO '{TEST_DIR}/lerobot_video_pipeline/data-000.parquet'
  (FORMAT PARQUET, OVERWRITE_OR_IGNORE TRUE);

statement ok
SET scheduler_process_partial = true;

query I
SELECT count(*)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_pipeline',
    [0],
    video_keys := ['observation.images.front'],
    producer_threads := 1,
    target_buffer_size := 256,
    max_pending_targets := 512
);
----
128

statement ok
SET scheduler_process_partial = false;
