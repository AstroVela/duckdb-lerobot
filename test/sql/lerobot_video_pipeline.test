# In synchronous scan mode the only DuckDB thread drives queued producer tasks
# itself; waiting on a condition variable here would deadlock.
statement ok
SET threads = 1;

statement ok
SET debug_physical_table_scan_execution_strategy = 'synchronous';

query I
SELECT count(*)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_video_pipeline',
    [0, 1],
    video_keys := ['observation.images.front'],
    producer_threads := 2,
    target_buffer_size := 1,
    max_pending_targets := 1
);
----
4

statement ok
SET debug_physical_table_scan_execution_strategy = 'default';

# LIMIT must cancel/deschedule producers without poisoning the next query on
# the same connection, with one or several threads and either scan strategy.
foreach workers 1 4

statement ok
SET threads = ${workers};

foreach strategy synchronous default

statement ok
SET debug_physical_table_scan_execution_strategy = '${strategy}';

loop cancelled_scan 0 3

