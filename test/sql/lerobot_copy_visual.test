# name: test/sql/lerobot_copy_visual.test
# description: Native COPY embeds images and writes concatenated RGB and depth video shards
# group: [sql]

require-env LEROBOT_FFMPEG_TESTS

require parquet

require json

require lerobot

statement ok
COPY (
    SELECT 0::BIGINT AS episode_index, 'image task'::VARCHAR AS task,
           CASE frame_index
               WHEN 0 THEN from_hex(repeat('14283c', 24))
               ELSE from_hex(repeat('1e2d3f', 24))
           END AS "observation.images.front",
           (frame_index / 10.0)::FLOAT AS action
    FROM range(2) frames(frame_index)
    ORDER BY frame_index
) TO '{TEST_DIR}/lerobot_copy_image' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.images.front":{"dtype":"image","shape":[4,6,3],"names":["height","width","channels"]},"action":{"dtype":"float32","shape":[1],"names":null}}'
);

query ITI
SELECT frame_index, ("observation.images.front").path,
	       octet_length(("observation.images.front").bytes) > 0
FROM lerobot_scan('{TEST_DIR}/lerobot_copy_image')
ORDER BY frame_index;
----
0	frame-000000.png	true
1	frame-000001.png	true

query IT
SELECT frame_index, left(hex(("observation.images.front").bytes), 16)
FROM lerobot_scan('{TEST_DIR}/lerobot_copy_image')
ORDER BY frame_index;
----
0	89504E470D0A1A0A
1	89504E470D0A1A0A

query RRR
SELECT round("stats/observation.images.front/mean"[1][1][1], 9),
       round("stats/observation.images.front/q01"[1][1][1], 9),
       round("stats/observation.images.front/q90"[1][1][1], 9)
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_image');
----
0.098039217	0.078431375	0.117645491

# At 474 frames NumPy's rounded-linspace sampler selects frame 237 at its
# midpoint, not frame 236. A white frame only at the latter catches a changed
# operation order in the sampling implementation.
statement ok
COPY (
    SELECT 0::BIGINT AS episode_index, 'sample task'::VARCHAR AS task,
           from_hex(CASE WHEN frame_index = 236 THEN 'ffffff' ELSE '000000' END)
               AS "observation.images.sample"
    FROM range(474) frames(frame_index)
    ORDER BY frame_index
) TO '{TEST_DIR}/lerobot_copy_image_sampling' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.images.sample":{"dtype":"image","shape":[1,1,3],"names":["height","width","channels"]}}'
);

query I
SELECT "stats/observation.images.sample/mean"[1][1][1] = 0
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_image_sampling');
----
true

# Two episodes share one MP4. Finalize performs an FFmpeg stream-copy concat,
# while episode routes retain the local half-open time ranges.
statement ok
COPY (
    SELECT episode_index, task, from_hex(repeat(pixel, 4096)) AS "observation.images.front", action
    FROM (VALUES
        (0::BIGINT, 'pick'::VARCHAR, '14283c', 0.0::FLOAT),
        (0::BIGINT, 'pick'::VARCHAR, '1e323f', 0.1::FLOAT),
        (1::BIGINT, 'place'::VARCHAR, '645a64', 1.0::FLOAT),
        (1::BIGINT, 'place'::VARCHAR, '6e6467', 1.1::FLOAT)
    ) frames(episode_index, task, pixel, action)
	ORDER BY episode_index, action
) TO '{TEST_DIR}/lerobot_copy_video' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.images.front":{"dtype":"video","shape":[64,64,3],"names":["height","width","channels"]},"action":{"dtype":"float32","shape":[1],"names":null}}',
    ENCODER_THREADS 1
);

query I
SELECT count(*)
FROM glob('{TEST_DIR}/lerobot_copy_video/videos/**/*.mp4');
----
1

query IRR
SELECT episode_index,
       round("videos/observation.images.front/from_timestamp", 3),
       round("videos/observation.images.front/to_timestamp", 3)
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_video')
ORDER BY episode_index;
----
0	0.0	0.2
1	0.2	0.4

query IIIIII
SELECT count(*), min(width), max(width), min(height), min(channels), min(octet_length(image))
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_video',
    [0, 1],
    video_keys := ['observation.images.front'],
    frame_indices := [0, 1]
);
----
4	64	64	64	3	12288

query III
SELECT contains(content, '"video.codec":"av1"'),
       contains(content, '"video.pix_fmt":"yuv420p"'),
       contains(content, '"video.g":2')
FROM read_text('{TEST_DIR}/lerobot_copy_video/meta/info.json');
----
true	true	true

# Each camera is spooled independently. Two dedicated codec workers encode the
# cameras concurrently under a two-thread total codec budget, and feature-order
# result registration keeps metadata deterministic. The byte contract applies
# to each active raw frame, not to the complete episode.
statement ok
COPY (
    SELECT 0::BIGINT AS episode_index, 'multi camera'::VARCHAR AS task,
           from_hex(repeat(CASE WHEN frame_index % 2 = 0 THEN '102030' ELSE '405060' END, 4096))
               AS "observation.images.front",
           from_hex(repeat(CASE WHEN frame_index % 2 = 0 THEN '706050' ELSE '302010' END, 4096))
               AS "observation.images.wrist"
    FROM range(12) frames(frame_index)
    ORDER BY frame_index
) TO '{TEST_DIR}/lerobot_copy_multi_camera' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.images.front":{"dtype":"video","shape":[64,64,3],"names":["height","width","channels"]},"observation.images.wrist":{"dtype":"video","shape":[64,64,3],"names":["height","width","channels"]}}',
    MAX_VISUAL_FRAME_BYTES 12288,
    VIDEO_WORKERS 2,
    ENCODER_THREADS 2
);

query II
SELECT count(*), count(DISTINCT regexp_extract(file, 'observation[.]images[.][^/]+'))
FROM glob('{TEST_DIR}/lerobot_copy_multi_camera/videos/**/*.mp4');
----
2	2

query III
SELECT count(*), count(DISTINCT video_key), min(octet_length(image))
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_multi_camera',
    [0],
    video_keys := ['observation.images.front', 'observation.images.wrist'],
    frame_indices := [0, 11]
);
----
4	2	12288

statement error
COPY (
    SELECT 0::BIGINT AS episode_index, 'too large'::VARCHAR AS task,
           from_hex(repeat('102030', 4096)) AS "observation.images.front"
) TO '{TEST_DIR}/lerobot_copy_visual_limit_failed' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.images.front":{"dtype":"video","shape":[64,64,3],"names":["height","width","channels"]}}',
    MAX_VISUAL_FRAME_BYTES 12287,
    ENCODER_THREADS 1
);
----
exceeding MAX_VISUAL_FRAME_BYTES=12287

query I
SELECT count(*)
FROM glob('{TEST_DIR}/lerobot_copy_visual_limit_failed*');
----
0

# Integer depth input is HWC uint16 little-endian in millimetres. It is
# quantized with LeRobot's 12-bit logarithmic mapping and encoded losslessly.
statement ok
COPY (
    SELECT 0::BIGINT AS episode_index, 'depth task'::VARCHAR AS task,
           CASE frame_index
               WHEN 0 THEN from_hex(repeat('d007', 4096))
               ELSE from_hex(repeat('b80b', 4096))
           END AS "observation.images.depth",
           (frame_index / 10.0)::FLOAT AS action
    FROM range(2) frames(frame_index)
    ORDER BY frame_index
) TO '{TEST_DIR}/lerobot_copy_depth' (
    FORMAT lerobot,
    FPS 10,
    FEATURES '{"observation.images.depth":{"dtype":"video","shape":[64,64,1],"names":["height","width","channels"],"info":{"is_depth_map":true}},"action":{"dtype":"float32","shape":[1],"names":null}}',
    ENCODER_THREADS 1
);

query II
SELECT count(*), min(size) > 0
FROM read_blob('{TEST_DIR}/lerobot_copy_depth/videos/**/*.mp4');
----
1	true

query IRRIII
SELECT count(*), round(min(decoded_timestamp), 3), round(max(decoded_timestamp), 3),
       min(channels), min(octet_length(image)), count(DISTINCT md5(image))
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_depth',
    [0],
    video_keys := ['observation.images.depth'],
    frame_indices := [0, 1]
);
----
2	0.0	0.1	1	16384	2

# Depth output is an HWC, one-channel, little-endian float32 BLOB. The default
# output unit is millimetres, matching native LeRobot's tensor contract. The
# encoded 2000 mm and 3000 mm inputs dequantize to 1999 mm and 3000 mm.
query IT
SELECT frame_index, md5(image)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_depth',
    [0],
    video_keys := ['observation.images.depth'],
    frame_indices := [0, 1]
)
ORDER BY frame_index;
----
0	ef7151749ffa8528e7d397c641b58bbc
1	2f6ddf3c05fb452214774f7241227112

query I
WITH millimetres AS (
    SELECT frame_index, image
    FROM lerobot_video_frames(
        '{TEST_DIR}/lerobot_copy_depth', [0],
        video_keys := ['observation.images.depth'], frame_indices := [0, 1]
    )
), metres AS (
    SELECT frame_index, image
    FROM lerobot_video_frames(
        '{TEST_DIR}/lerobot_copy_depth', [0],
        video_keys := ['observation.images.depth'], frame_indices := [0, 1],
        depth_output_unit := 'm'
    )
)
SELECT count(*)
FROM millimetres JOIN metres USING (frame_index)
WHERE millimetres.image != metres.image;
----
2

query IIII
SELECT min(width), min(height), min(channels), min(octet_length(image))
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_depth', [0],
    video_keys := ['observation.images.depth'], frame_indices := [0, 1],
    width := 32, height := 16
);
----
32	16	1	2048

query III
SELECT min(channels), min(octet_length(image)), count(DISTINCT md5(image))
FROM lerobot_video_windows(
    '{TEST_DIR}/lerobot_copy_depth',
    [struct_pack(request_id := 7::BIGINT, episode_index := 0::BIGINT, frame_index := 0::BIGINT)],
    video_keys := ['observation.images.depth'],
    delta_timestamps := [0.0, 0.1]
);
----
1	16384	2

query III
SELECT min(channels), min(octet_length(image)), count(DISTINCT md5(image))
FROM lerobot_video_targets(
    '{TEST_DIR}/lerobot_copy_depth',
    (SELECT * FROM (VALUES
        (7, 0, 0, 'observation.images.depth', 0),
        (7, 0, 0, 'observation.images.depth', 1)
    ) targets(request_id, episode_index, frame_index, video_key, delta_index)),
    delta_timestamps := [0.0, 0.1]
);
----
1	16384	2

statement error
SELECT *
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_depth', [0],
    video_keys := ['observation.images.depth'],
    depth_output_unit := 'cm'
);
----
depth_output_unit must be 'm' or 'mm'

query RII
SELECT "stats/observation.images.depth/mean"[1][1][1],
	       abs("stats/observation.images.depth/q90"[1][1][1] - 2999.960009765625) < 1e-9,
	       abs("stats/observation.images.depth/q99"[1][1][1] - 2999.9960009765623) < 1e-9
FROM lerobot_episodes('{TEST_DIR}/lerobot_copy_depth');
----
2500.0	true	true

query IIII
SELECT contains(content, '"video.codec":"hevc"'),
       contains(content, '"video.pix_fmt":"gray12le"'),
       contains(content, '"x265-params":"lossless=1:open-gop=0"'),
       contains(content, '"depth_unit":"mm"')
FROM read_text('{TEST_DIR}/lerobot_copy_depth/meta/info.json');
----
true	true	true	true

# The decoder consumes the quantizer configuration from info.json instead of
# assuming the writer defaults. Reinterpret the same lossless codes with a
# linear [0.5 m, 6.5 m] mapping, then force metadata-cache refresh.
statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           10 AS fps,
           1 AS total_episodes,
           2 AS total_frames,
           1 AS total_tasks,
           1000 AS chunks_size,
           100 AS data_files_size_in_mb,
           200 AS video_files_size_in_mb,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           struct_pack(
               "observation.images.depth" := struct_pack(
                   dtype := 'video',
                   shape := [64, 64, 1],
                   names := ['height', 'width', 'channels'],
                   info := struct_pack(
                       "video.pix_fmt" := 'gray12le',
                       "video.depth_min" := 0.5,
                       "video.depth_max" := 6.5,
                       "video.shift" := 2.0,
                       "video.use_log" := false,
                       is_depth_map := true,
                       depth_unit := 'mm'
                   )
               )
           ) AS features
) TO '{TEST_DIR}/lerobot_copy_depth/meta/info.json'
  (FORMAT JSON, ARRAY false, OVERWRITE_OR_IGNORE);

query IT
SELECT frame_index, md5(image)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_depth',
    [0],
    video_keys := ['observation.images.depth'],
    frame_indices := [0, 1],
    refresh := true
)
ORDER BY frame_index;
----
0	fe2d98d6954082cd58fae41556ffe863
1	8ab5e0de62c66c63cb75d6557620796c

# The same linear mapping has exact, libm-independent float32 metre values.
query IT
SELECT frame_index, md5(image)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_depth',
    [0],
    video_keys := ['observation.images.depth'],
    frame_indices := [0, 1],
    depth_output_unit := 'm'
)
ORDER BY frame_index;
----
0	4a1da32fd15a860f8e2c62de9bea0e53
1	53ab1bf11cc87bf1503c7b49a498ae5f

# Exercise non-default logarithmic bounds and shift independently of the
# writer defaults, so every persisted dequantizer parameter affects the result.
statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           10 AS fps,
           1 AS total_episodes,
           2 AS total_frames,
           1 AS total_tasks,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           struct_pack(
               "observation.images.depth" := struct_pack(
                   dtype := 'video',
                   shape := [64, 64, 1],
                   names := ['height', 'width', 'channels'],
                   info := struct_pack(
                       "video.pix_fmt" := 'gray12le',
                       "video.depth_min" := 0.5,
                       "video.depth_max" := 6.5,
                       "video.shift" := 0.25,
                       "video.use_log" := true,
                       is_depth_map := true
                   )
               )
           ) AS features
) TO '{TEST_DIR}/lerobot_copy_depth/meta/info.json'
  (FORMAT JSON, ARRAY false, OVERWRITE_OR_IGNORE);

query IT
SELECT frame_index, md5(image)
FROM lerobot_video_frames(
    '{TEST_DIR}/lerobot_copy_depth',
    [0],
    video_keys := ['observation.images.depth'],
    frame_indices := [0, 1],
    refresh := true
)
ORDER BY frame_index;
----
0	f2de9917cad819203a02c0203b70517a
1	409d325a23268841009e29170c4dc725

# Actual stream format is checked whenever decoding occurs, even when image is
# projected away. Re-label the RGB fixture as depth without changing its MP4.
statement ok
COPY (
    SELECT 'v3.0' AS codebase_version,
           10 AS fps,
           2 AS total_episodes,
           4 AS total_frames,
           2 AS total_tasks,
           'data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet' AS data_path,
           'videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4' AS video_path,
           struct_pack(
               "observation.images.front" := struct_pack(
                   dtype := 'video',
                   shape := [64, 64, 1],
                   names := ['height', 'width', 'channels'],
                   info := struct_pack(
                       "video.pix_fmt" := 'gray12le',
                       "video.depth_min" := 0.01,
                       "video.depth_max" := 10.0,
                       "video.shift" := 3.5,
                       "video.use_log" := true,
                       is_depth_map := true
                   )
               )
           ) AS features
) TO '{TEST_DIR}/lerobot_copy_video/meta/info.json'
  (FORMAT JSON, ARRAY false, OVERWRITE_OR_IGNORE);

statement error
