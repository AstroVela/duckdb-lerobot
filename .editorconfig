root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cpp,hpp,h,c}]
indent_style = tab
indent_size = tab
tab_width = 4
max_line_length = 120

[*.{test,md}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
